# name: test/sql/is_true.test
# description: is_true(): the scalar form of a noul, wherever an expression goes
# group: [typesafe]
#
# Runs against the bundled mock endpoint (test/mock_api/server.py), started by
# ci/run-integration.sh: deterministic keyword-overlap answers, so values are exact.
# {TYPESAFE_MOCK_URL}/__test/requests?tag=<unique> returns how many API requests
# were made since the previous tag.

require vgi

require-env VGI_TYPESAFE_WORKER

require-env TYPESAFE_MOCK_URL

statement ok
ATTACH 'typesafe' (TYPE vgi, LOCATION '{VGI_TYPESAFE_WORKER}');

statement ok
CREATE SECRET ts (TYPE typesafe, api_key 'test-key', base_url '{TYPESAFE_MOCK_URL}');

statement ok
LOAD httpfs;

statement ok
LOAD json;

statement ok
SELECT n FROM read_json('{TYPESAFE_MOCK_URL}/__test/requests?tag=it-0');

query T
SELECT typesafe.main.is_true('My package never arrived', 'Is this message about a lost package?');
----
0.731059

# A judgment inline in WHERE; the NULL row is NULL, not true, so WHERE drops it.
query I
SELECT t.id FROM (VALUES (1, 'My package never arrived'), (2, 'Thanks for the quick refund'), (3, NULL)) t(id, body)
WHERE typesafe.main.is_true(t.body, 'Is this message about a lost package?') > 0.5
ORDER BY t.id;
----
1

query I
SELECT n FROM read_json('{TYPESAFE_MOCK_URL}/__test/requests?tag=it-1');
----
3

# In CASE and ORDER BY.
query IT
SELECT t.id, CASE WHEN typesafe.main.is_true(t.body, 'Is this message about a lost package?') > 0.5
                  THEN 'shipping' ELSE 'other' END
FROM (VALUES (1, 'Thanks for the quick refund'), (2, 'My package never arrived')) t(id, body)
ORDER BY typesafe.main.is_true(t.body, 'Is this message about a lost package?') DESC;
----
2	shipping
1	other

# The scalar and the table function agree on the same row.
query T
SELECT typesafe.main.is_true('My package never arrived', 'Is this message about a lost package?')
     = (SELECT noul FROM typesafe.main.noul('My package never arrived',
           instructions => 'Is this message about a lost package?'));
----
true

# Beside a LATERAL question, projected and then filtered outside.
query T
WITH routed AS (SELECT t.body, c.choice, typesafe.main.is_true(t.body, 'Is the customer asking for a refund?') AS refund
FROM (VALUES ('I was charged twice, please refund me'), ('My invoice shows a wrong charge'),
      ('My package never arrived')) t(body),
     LATERAL typesafe.main.choice(t.body, instructions => 'Which team should handle this?',
         criteria => MAP {'shipping': 'Delivery status, delays, lost packages',
                          'billing': 'Charges, invoices, payment problems'}) c)
SELECT body FROM routed WHERE choice = 'billing' AND refund > 0.5 ORDER BY body;
----
I was charged twice, please refund me

# The natural spelling: the scalar in the same WHERE as the LATERAL. This was an
# extension bug (constant arguments erased at bind) and works on the released extension.
query T
SELECT t.body
FROM (VALUES ('I was charged twice, please refund me'), ('My invoice shows a wrong charge'),
      ('My package never arrived')) t(body),
     LATERAL typesafe.main.choice(t.body, instructions => 'Which team should handle this?',
         criteria => MAP {'shipping': 'Delivery status, delays, lost packages',
                          'billing': 'Charges, invoices, payment problems'}) c
WHERE c.choice = 'billing' AND typesafe.main.is_true(t.body, 'Is the customer asking for a refund?') > 0.5 ORDER BY t.body;
----
I was charged twice, please refund me

statement ok
SELECT n FROM read_json('{TYPESAFE_MOCK_URL}/__test/requests?tag=it-2');

# A blank question is rejected at bind.
statement error
SELECT typesafe.main.is_true('hello', '');
----
needs a question

query I
SELECT n FROM read_json('{TYPESAFE_MOCK_URL}/__test/requests?tag=it-3');
----
0
