# name: test/sql/examples.test
# description: Every published example and README walkthrough statement runs against the mock
# group: [typesafe]
#
# GENERATED by tests/test_examples.py from the worker's example carriers and the
# README; do not edit. Regenerate: UPDATE_SQL_TESTS=1 uv run pytest tests/test_examples.py

require vgi

require-env VGI_TYPESAFE_WORKER

require-env TYPESAFE_MOCK_URL

statement ok
LOAD json;

statement ok
ATTACH 'typesafe' (TYPE vgi, LOCATION '{VGI_TYPESAFE_WORKER}');

statement ok
CREATE SECRET ts (TYPE typesafe, api_key 'test-key', base_url '{TYPESAFE_MOCK_URL}');

# ask Meta.examples: Route, flag and grade every row of a table in one pass
query I
SELECT count(*) > 0 FROM (
SELECT t.id, a.dept.choice AS dept, a.urgent.noul AS urgent, a.severity.score AS severity FROM (VALUES (1, 'My package is lost, this is unacceptable'), (2, 'Thanks, one invoice question')) t(id, body), LATERAL typesafe.main.ask(t, questions => {'dept': {'type': 'choice', 'instructions': 'Which team should handle this?', 'criteria': {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems'}}, 'urgent': {'type': 'noul', 'instructions': 'Is the customer angry?', 'criteria': {'true': 'angry, furious, unacceptable', 'false': 'calm, thanks'}}, 'severity': {'type': 'score', 'instructions': 'How bad is it?', 'criteria': ['minor question', 'disruptive delay', 'critical outage']}}) a ORDER BY t.id
);
----
true

# ask Meta.examples: Ask several questions about a single literal
query I
SELECT count(*) > 0 FROM (
SELECT dept.choice, urgent.noul FROM typesafe.main.ask('I was charged twice', questions => {'dept': {'type': 'choice', 'instructions': 'Which team should handle this?', 'criteria': {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems'}}, 'urgent': {'type': 'noul', 'instructions': 'Is the customer angry?', 'criteria': {'true': 'angry, furious, unacceptable', 'false': 'calm, thanks'}}, 'severity': {'type': 'score', 'instructions': 'How bad is it?', 'criteria': ['minor question', 'disruptive delay', 'critical outage']}})
);
----
true

