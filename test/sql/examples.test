# is_true Meta.examples: Keep only the rows a yes/no question is true of
query I
SELECT count(*) > 0 FROM (
SELECT t.body FROM (VALUES ('My package never arrived'), ('Thanks for the quick refund')) t(body) WHERE typesafe.main.is_true(t.body, 'Is this message about a lost package?') > 0.5
);
----
true

# is_true Meta.examples: Ask about one literal
query I
SELECT count(*) > 0 FROM (
SELECT typesafe.main.is_true('My package never arrived', 'Is this message about a lost package?') AS lost_package
);
----
true

# is_true Meta.examples: Route every message to a team, then keep only the billing messages that ask for a refund
query I
SELECT count(*) > 0 FROM (
WITH routed AS (SELECT t.body, c.choice, typesafe.main.is_true(t.body, 'Is the customer asking for a refund?') AS refund FROM (VALUES ('I was charged twice, please refund me'), ('My invoice shows a wrong charge'), ('My package never arrived')) t(body), LATERAL typesafe.main.choice(t.body, instructions => 'Which team should handle this?', criteria => MAP {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems'}) c) SELECT body, refund FROM routed WHERE choice = 'billing' AND refund > 0.5 ORDER BY refund DESC, body
);
----
true

