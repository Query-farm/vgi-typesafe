# agent grader: count_refund_requests_per_team
query I
SELECT count(*) > 0 FROM (
SELECT c.choice AS team, count_if(typesafe.main.is_true(t.body, 'Is the customer asking for a refund?') > 0.5) AS refund_requests FROM (VALUES ('I was charged twice, please refund me'), ('My invoice shows a wrong charge'), ('Please refund the duplicate charge on my invoice'), ('My package never arrived and I want a refund'), ('My package never arrived')) t(body), LATERAL typesafe.main.choice(t.body, instructions => 'Which team should handle this?', criteria => MAP {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems'}) c GROUP BY c.choice ORDER BY team
);
----
true

# agent grader: which_models_can_i_ask_for
query I
SELECT count(*) > 0 FROM (
SELECT name, description, release_date FROM typesafe.main.models() ORDER BY name
);
----
true

# README walkthrough, against a small `tickets` table.
statement ok
CREATE TABLE tickets AS SELECT * FROM (VALUES (1, 'My package never arrived and tracking has not updated', 'gold'), (2, 'I was charged twice on my invoice', 'free')) t(id, body, tier);

# README block 1
statement ok
SELECT choice, confidence
FROM typesafe.main.choice('My package never arrived and tracking has not updated',
    instructions => 'Which team should handle this?',
    criteria => MAP {'shipping': 'Delivery status, delays, lost packages',
                     'billing':  'Charges, invoices, payment problems',
                     'returns':  'Exchanges, refunds, wrong or damaged items'});

# README block 2
statement ok
SELECT t.id, c.choice AS team, c.confidence
FROM tickets t,
     LATERAL typesafe.main.choice(t.body,
         instructions => 'Which team should handle this?',
         criteria => MAP {'shipping': 'Delivery status, delays, lost packages',
                          'billing':  'Charges, invoices, payment problems',
                          'returns':  'Exchanges, refunds, wrong or damaged items'}) c;

# README block 3
statement ok
CREATE TABLE routed AS
SELECT t.id, t.body, c.choice AS team, c.confidence
FROM tickets t,
     LATERAL typesafe.main.choice(t.body,
         instructions => 'Which team should handle this?',
         criteria => MAP {'shipping': 'Delivery status, delays, lost packages',
                          'billing':  'Charges, invoices, payment problems',
                          'returns':  'Exchanges, refunds, wrong or damaged items'}) c;

# README block 3
statement ok
SELECT * FROM routed WHERE confidence >= 0.8;

# README block 3
statement ok
SELECT * FROM routed WHERE confidence <  0.8;

# README block 4
statement ok
WITH routed AS (
    SELECT t.id, t.body, c.choice AS team, c.confidence
    FROM tickets t,
         LATERAL typesafe.main.choice(t.body,
             instructions => 'Which team should handle this?',
             criteria => MAP {'shipping': 'Delivery status, delays, lost packages',
                              'billing':  'Charges, invoices, payment problems'}) c)
SELECT r.id, r.body, s.score AS how_bad    -- 0..2 on the scale below
FROM routed r,
     LATERAL typesafe.main.score(r.body,
         instructions => 'How bad is this delivery problem?',
         criteria => ['short delay', 'long delay', 'lost package']) s
WHERE r.team = 'shipping' AND r.confidence >= 0.8
ORDER BY s.score DESC;

# README block 5
statement ok
SELECT t.id,
       a.team.choice     AS team,
       a.team.confidence AS team_confidence,
       a.urgent.noul     AS urgency,        -- 0..1; near 1 is yes
       a.severity.score  AS severity        -- 0..2 on the scale below
FROM tickets t,
     LATERAL typesafe.main.ask(t.body, questions => {
         'team':     {'type': 'choice', 'instructions': 'Which team should handle this?',
                      'criteria': {'shipping': 'Delivery status, delays, lost packages',
                                   'billing':  'Charges, invoices, payment problems',
                                   'returns':  'Exchanges, refunds, wrong or damaged items'}},
         'urgent':   {'type': 'noul',  'instructions': 'Does this need a reply today?'},
         'severity': {'type': 'score', 'instructions': 'How severe is this?',
                      'criteria': ['minor question', 'disruptive delay', 'critical outage']}}) a
ORDER BY a.severity.score DESC;

# README block 6
statement ok
SELECT t.id, a.urgent.noul AS urgency
FROM tickets t,
     LATERAL typesafe.main.ask(t, questions => {
         'urgent': {'type': 'noul',
                    'instructions': 'Does this need a reply today? Weigh the customer tier.'}}) a;

# README block 7
statement ok
SELECT * FROM tickets
WHERE typesafe.main.is_true(body, 'Is this an angry complaint?') > 0.5;

# README block 8
statement ok
DESCRIBE SELECT * FROM typesafe.main.ask('x', questions => {
    'team':   {'type': 'choice', 'instructions': 'Which team?',
               'criteria': {'shipping': 'Lost packages', 'billing': 'Invoices'}},
    'urgent': {'type': 'noul', 'instructions': 'Needs a reply today?'}});
