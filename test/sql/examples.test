SELECT t.body, c.choice, c.confidence FROM (VALUES ('My package never arrived'), ('I was charged twice')) t(body), LATERAL typesafe.main.choice(t.body, instructions => 'Which team should handle this?', criteria => MAP {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems'}) c
