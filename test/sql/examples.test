true

# schema vgi.example_queries: Route each message, then ask it the follow-up question that belongs to the team it was routed to
query I
SELECT count(*) > 0 FROM (
WITH routed AS (SELECT t.body, c.choice FROM (VALUES ('My package never arrived'), ('I was charged twice, please refund me'), ('My invoice shows a wrong charge')) t(body), LATERAL typesafe.main.choice(t.body, instructions => 'Which team should handle this?', criteria => MAP {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems'}) c), follow_ups(team, questions) AS (VALUES ('shipping', '{"lost": {"type": "noul", "instructions": "Is the package lost?"}}'), ('billing', '{"refund": {"type": "noul", "instructions": "Is the customer asking for a refund?"}}')) SELECT r.body, r.choice AS team, a.answers FROM routed r JOIN follow_ups f ON f.team = r.choice, LATERAL typesafe.main.ask_dynamic(r.body, f.questions) a ORDER BY r.body
);
----
true

# vgi.executable_examples: ask_shapes_its_columns_from_the_questions
query I
SELECT count(*) > 0 FROM (
DESCRIBE SELECT * FROM typesafe.main.ask('a lost package', questions => {'dept': {'type': 'choice', 'instructions': 'Which team?', 'criteria': {'shipping': 'Delays and lost packages', 'billing': 'Invoices'}}, 'urgent': {'type': 'noul', 'instructions': 'Does this need a reply today?'}})
);
----
true

# agent grader: route_a_support_ticket
query I
SELECT count(*) > 0 FROM (
SELECT choice, confidence FROM typesafe.main.choice( 'My package never arrived and the tracking has not updated in a week.', instructions => 'Which team should handle this?', criteria => MAP {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems', 'returns': 'Exchanges, refunds, damaged items'})
);
----
true

# agent grader: several_judgments_one_request
query I
SELECT count(*) > 0 FROM (
SELECT a.dept.choice, a.angry.noul, a.severity.score FROM typesafe.main.ask( 'I was charged twice and nobody has replied to me in three days', questions => {'dept': {'type': 'choice', 'instructions': 'Which team should handle this?', 'criteria': {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems'}}, 'angry': {'type': 'noul', 'instructions': 'Is the customer angry?'}, 'severity': {'type': 'score', 'instructions': 'How severe is this?', 'criteria': ['minor question', 'disruptive delay', 'critical outage']}}) a
);
----
true

# agent grader: ask_each_row_its_own_question
query I
SELECT count(*) > 0 FROM (
SELECT t.id, a.answers->'dept'->>'choice' AS dept, a.answers->'urgent'->>'noul' AS urgent FROM (VALUES (1, 'My package is lost and delivery is delayed', '{"dept": {"type": "choice", "instructions": "Which team should handle this?", "criteria": {"shipping": "Delivery status, delays, lost packages", "billing": "Charges, invoices, payment problems"}}}'), (2, 'Thanks, just one routine question', '{"urgent": {"type": "noul", "instructions": "Does this need a reply today?"}}')) t(id, body, questions), LATERAL typesafe.main.ask_dynamic(t.body, t.questions) a ORDER BY t.id
);
----
true

# agent grader: route_only_the_confident_ones
query I
SELECT count(*) > 0 FROM (
SELECT t.body, c.choice FROM (VALUES ('my package is lost in delivery'), ('my invoice shows a wrong charge')) t(body), LATERAL typesafe.main.choice(t.body, instructions => 'Which team should handle this?', criteria => MAP {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems'}) c WHERE c.confidence > 0.8
);
----
true

# agent grader: judge_a_whole_row
query I
SELECT count(*) > 0 FROM (
SELECT t.id, a.urgent.noul FROM (VALUES (1, 'my parcel is lost', 'gold', 'A-104')) t(id, message, tier, order_id), LATERAL typesafe.main.ask(t, questions => {'urgent': {'type': 'noul', 'instructions': 'Does this need a reply today?'}}) a
);
----
true

