# schema vgi.example_queries: Rate how bad each delivery problem is, for only the messages confidently routed to shipping
query I
SELECT count(*) > 0 FROM (
WITH routed AS (SELECT t.body, c.choice, c.confidence FROM (VALUES ('My package never arrived'), ('The delivery is delayed and the package looks lost'), ('Delivery status says delayed by a week'), ('I was charged twice on my invoice')) t(body), LATERAL typesafe.main.choice(t.body, instructions => 'Which team should handle this?', criteria => MAP {'shipping': 'Delivery status, delays, lost packages', 'billing': 'Charges, invoices, payment problems'}) c) SELECT r.body, s.score, s.confidence FROM routed r, LATERAL typesafe.main.score(r.body, instructions => 'How bad is this delivery problem?', criteria => ['short delay', 'long delay', 'lost package']) s WHERE r.choice = 'shipping' AND r.confidence > 0.8 ORDER BY s.score DESC, r.body
);
----
true

